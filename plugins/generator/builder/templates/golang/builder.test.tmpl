{{- /* The checks over a generated builder.

       Every assertion goes through the backend's assertion dialect —
       `assertEqual` and friends — so the generated file depends on
       nothing but `testing`, and a repository preferring a helper
       library replaces the dialect rather than these templates.

       One t.Run per asserted behaviour, each parallel, so a failure
       names the property that broke rather than the function it was
       written in. */ -}}

{{- define "builder.test" -}}
{{- $T := renderExpr (external "testing" "T") -}}
{{- $cmpDiff := renderExpr (external "github.com/google/go-cmp/cmp" "Diff") -}}
{{- $cmpExporter := renderExpr (external "github.com/google/go-cmp/cmp" "Exporter") -}}
{{- $cmpFilterValues := renderExpr (external "github.com/google/go-cmp/cmp" "FilterValues") -}}
{{- $cmpComparer := renderExpr (external "github.com/google/go-cmp/cmp" "Comparer") -}}
{{- $reflectType := renderExpr (external "reflect" "Type") -}}
{{- $reflectTypeOf := renderExpr (external "reflect" "TypeOf") -}}
{{- $reflectValueOf := renderExpr (external "reflect" "ValueOf") -}}
{{- $reflectFunc := renderExpr (external "reflect" "Func") -}}
{{- $diffFn := printf "%sDiff" (camel .TypeName) -}}
{{- $b := .TypeName -}}
{{- $src := .SourceName -}}
{{- $ta := .TypeArgs -}}
{{- $ctor := renderExpr .CtorRef -}}
{{- $from := renderExpr .FromRef -}}
{{- $v := renderExpr .ValueRef -}}
{{- if not .Instantiable }}
// {{ testFuncName $b "" }} is not generated: [{{ $src }}] is parameterised and
// its constraints admit no concrete type to instantiate at, so there is
// nothing a check could name. Write one by hand at the types your own code
// uses.
{{- else }}
// {{ $diffFn }} compares two member values structurally.
//
// `==` cannot serve. Go rejects it outright on a member whose type holds a
// slice or a map, and a composite literal written into the header of an `if`
// does not parse even where the operator is legal — so an equality check over
// an ordinary struct member did not compile at all.
//
// Two options make it answer for a member of any type, and without them the
// default does something worse than refuse.
//
// The exporter, because cmp panics on an unexported field rather than
// reporting one, and a member's type belongs to the package under test — so
// a check over an ordinary struct would panic inside the consumer's suite.
//
// The func comparer, because cmp reports two func values as different
// whenever both are non-nil, including a func compared against itself. Code
// pointers are what a check can honestly ask about: the member either holds
// the func it was given or it does not.
func {{ $diffFn }}(want, got any) string {
	return {{ $cmpDiff }}(want, got,
		{{ $cmpExporter }}(func({{ $reflectType }}) bool { return true }),
		{{ $cmpFilterValues }}(
			func(x, y any) bool {
				return x != nil && y != nil &&
					{{ $reflectTypeOf }}(x).Kind() == {{ $reflectFunc }} &&
					{{ $reflectTypeOf }}(y).Kind() == {{ $reflectFunc }}
			},
			{{ $cmpComparer }}(func(x, y any) bool {
				return {{ $reflectValueOf }}(x).Pointer() == {{ $reflectValueOf }}(y).Pointer()
			}),
		),
	)
}

// {{ testFuncName $b "Construction" }} pins what the constructors produce.
func {{ testFuncName $b "Construction" }}(t *{{ $T }}) {
	t.Parallel()

{{ template "builder.test.construction" . }}
}

// {{ testFuncName $b "Setters" }} pins that each setter writes the member it
// names, and writes nothing else.
func {{ testFuncName $b "Setters" }}(t *{{ $T }}) {
	t.Parallel()

{{ template "builder.test.setters" . }}
}
{{- if .Copies }}

// {{ testFuncName $b "Clone" }} pins that a clone can be configured without
// the original seeing it.
func {{ testFuncName $b "Clone" }}(t *{{ $T }}) {
	t.Parallel()

{{ template "builder.test.clone" . }}
}
{{- end }}
{{- range (slot . "checks").Items }}

{{ render . }}
{{- end }}
{{- end }}
{{- end -}}

{{- /* What the constructors produce.

       Compared member by member rather than as whole values: a struct
       holding a sequence or a mapping is not comparable in Go, so a
       whole-value assertion does not compile at all — and where it
       does, it names the type rather than the member that broke. */ -}}
{{- define "builder.test.construction" -}}
{{- $T := renderExpr (external "testing" "T") -}}
{{- $diffFn := printf "%sDiff" (camel .TypeName) -}}
{{- $ctor := renderExpr .CtorRef -}}
{{- $from := renderExpr .FromRef -}}
{{- $v := renderExpr .ValueRef -}}
{{- $ta := .TypeArgs -}}
{{- if .Seedable }}
	t.Run("From round-trips what it was seeded with", func(t *{{ $T }}) {
		t.Parallel()
		// Seeded with named values rather than a zero value: a round
		// trip comparing a zero against itself passes against a builder
		// that dropped every member it was given.
		var seed {{ $v }}{{ $ta }}
{{- range .Seedable }}
		seed.{{ .Name }} = {{ template "builder.sample" . }}
{{- end }}
		got := {{ $from }}{{ $ta }}(seed).Build()
{{- range .Seedable }}
		{{ assertDeepEqual "t" $diffFn (printf "got.%s" .Name) (printf "seed.%s" .Name) "From keeps the member it was given" }}
{{- end }}
	})
{{- end }}
{{- range .Fields }}{{ if and .Declared (not .DefaultRef) }}
{{- if not .DefaultIsZero }}

	t.Run("{{ .Name }} carries its declared default", func(t *{{ $T }}) {
		t.Parallel()
		{{ assertDeepEqual "t" $diffFn (printf "%s%s().Build().%s" $ctor $ta .Name) .Default "the constructor applies the declared default" }}
	})
{{- end }}
{{- end }}{{ end }}
{{- end -}}

{{- /* One check per setter that has a value to write. */ -}}
{{- define "builder.test.setters" -}}
{{- $diffFn := printf "%sDiff" (camel .TypeName) -}}
{{- $T := renderExpr (external "testing" "T") -}}
{{- $ctor := renderExpr .CtorRef -}}
{{- $ta := .TypeArgs -}}
{{- $generic := .Generic -}}
{{- range $f := .Fields }}
{{- if and $f.Sample.OK (not $generic) }}
{{- $with := $f.Set }}
	t.Run("{{ $with }} writes {{ $f.Name }}", func(t *{{ $T }}) {
		t.Parallel()
{{- if $f.IsSequence }}
		// Spread, because the replacing setter is variadic: it takes the
		// elements, and the sample of a sequence type is the whole thing.
		got := {{ $ctor }}{{ $ta }}().{{ $with }}({{ template "builder.sample" $f }}...).Build()
		{{ assertLen "t" (printf "got.%s" $f.Name) 1 "the setter replaces the sequence" }}
{{- else if $f.Keyed }}
		// Driven through the replacing setter rather than the entry one:
		// a sample of a keyed type is the whole collection, and the entry
		// setter takes a key — which this projection has no sample of.
		got := {{ $ctor }}{{ $ta }}().{{ $with }}({{ template "builder.sample" $f }}).Build()
		{{ assertLen "t" (printf "got.%s" $f.Name) 1 "the setter replaces the collection" }}
{{- else if $f.IsBytes }}
		// Compared by length rather than by value: a byte sequence is a
		// slice, and Go compares a slice only against nil.
		got := {{ $ctor }}{{ $ta }}().{{ $with }}({{ template "builder.sample" $f }}).Build()
		{{ assertLen "t" (printf "got.%s" $f.Name) 1 "the setter replaces the sequence" }}
{{- else if $f.IsOptional }}
		got := {{ $ctor }}{{ $ta }}().{{ $with }}({{ template "builder.sample" $f }}).Build()
		{{ assertNotNil "t" (printf "got.%s" $f.Name) "the setter addresses the value it was given" }}
{{- else }}
		// Bound rather than written twice. A sample is an expression,
		// and some of them make a new value each time they are
		// evaluated — a channel's `make`, a func literal — so a check
		// spelling it in both places compares two different values and
		// fails against a setter that did exactly what it was asked.
		//
		// Declared at the member's type rather than inferred from the
		// sample. A directional channel takes its value from a `make`
		// of the bidirectional form, so the inferred binding is a
		// `chan T` where the member is a `<-chan T` — and a structural
		// comparison of two different types reports a difference
		// whatever the values are.
		var want {{ renderType $f.Type }} = {{ template "builder.sample" $f }}
		got := {{ $ctor }}{{ $ta }}().{{ $with }}(want).Build()
		{{ assertDeepEqual "t" $diffFn (printf "got.%s" $f.Name) "want" "the setter writes what it was given" }}
{{- end }}
	})
{{ if and $f.IsScalar $f.Alternate.OK }}
	t.Run("{{ $with }} replaces what was already there", func(t *{{ $T }}) {
		t.Parallel()
		// Two distinct values, because the check above cannot tell a
		// working setter from one that does nothing: if the constructor
		// already seeded the value being written, asserting it is there
		// afterwards passes either way. Writing twice and asserting the
		// second won cannot pass vacuously.
		var want {{ renderType $f.Type }} = {{ template "builder.alternate" $f }}
		got := {{ $ctor }}{{ $ta }}().{{ $with }}({{ template "builder.sample" $f }}).{{ $with }}(want).Build()
		{{ assertDeepEqual "t" $diffFn (printf "got.%s" $f.Name) "want" "the later call wins" }}
	})
{{ end }}
{{- end }}
{{- end }}
{{- end -}}

{{- /* Clone independence, for the members that own storage. */ -}}
{{- define "builder.test.clone" -}}
{{- $T := renderExpr (external "testing" "T") -}}
{{- $ctor := renderExpr .CtorRef -}}
{{- $ta := .TypeArgs -}}
{{- range $f := .Fields }}
{{- if and $f.Copies $f.Sample.OK }}
{{- $with := $f.Set }}
	t.Run("{{ $f.Name }} is not shared with a clone", func(t *{{ $T }}) {
		t.Parallel()
		original := {{ $ctor }}{{ $ta }}()
		clone := original.Clone()
{{- if $f.Keyed }}
		clone.{{ $with }}({{ template "builder.sample" $f }})
{{- else if $f.IsSequence }}
		clone.{{ $f.Append }}({{ template "builder.sample" $f }}...)
{{- else }}
		clone.{{ $with }}({{ template "builder.sample" $f }})
{{- end }}
		{{ assertLen "t" (printf "original.Build().%s" $f.Name) 0 "writing through a clone must not reach the original" }}
	})
{{ end }}
{{- end }}
{{- end -}}

{{- /* A member's sample value, and its second distinct one. */ -}}
{{- define "builder.sample" -}}{{ renderSample .Sample }}{{- end -}}
{{- define "builder.alternate" -}}{{ renderSample .Alternate }}{{- end -}}
