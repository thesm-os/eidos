{{- /* The Go spelling of a builder.

       The words `With`, `Append`, `Entry` and the PascalCase joining
       them are Go's conventions and are declared as such, in the
       binding beside this tree — so a setter's identifier arrives on
       the projection already spelled, along with the shape that
       decided which setters the member owes.

       Composed here once, they could not be checked for collision:
       two members can reach one identifier, and a template writing
       both emits a duplicate method that is reported against the
       consumer's build rather than the declaration that caused it. */ -}}

{{- define "builder.type" -}}
{{- $b := .TypeName -}}
{{- $src := .SourceName -}}
{{- $tp := renderTypeParams .TypeParams -}}
{{- $ta := .TypeArgs -}}
{{- $v := renderExpr .ValueRef -}}
{{ wrapDoc (printf "%s constructs [%s] values.\n\nStart with [%s] or [%s], set what you care about, and call [%s.Build].\n\nThe point is what you do not have to write. A composite literal restates every member each time, so a member added to %s breaks every literal at once and a reader cannot tell which members a given call site actually cares about. Here the constructor supplies the rest, and each call states only what it varies.\n\nEvery setter returns the builder, so calls chain. A builder is a value under construction and is not safe for concurrent use; [%s.Clone] is how one becomes two." $b $src .CtorName .FromName $b $src $b) }}
type {{ $b }}{{ $tp }} struct {
	v {{ $v }}{{ $ta }}
}

{{ template "builder.ctor" . }}

{{ wrapDoc (printf "%s returns a builder seeded with v.\n\nFor the case where a caller already holds a value and wants one member different — a round trip, a near-copy, a regression fixture built from something a previous step produced." .FromName) }}
func {{ .FromName }}{{ $tp }}(v {{ $v }}{{ $ta }}) *{{ $b }}{{ $ta }} {
	return &{{ $b }}{{ $ta }}{v: v}
}
{{ template "builder.setters" . }}
{{- range (slot . "setters").Items }}
{{ render . }}
{{- end }}

// Mutate applies fn to the value under construction.
//
// The way out for what the setters do not reach: a member this
// builder cannot name, a shape it does not model, or a change that
// touches several members at once and only makes sense as one edit.
//
// Prefer a setter where one exists. A setter says which member it
// writes, and a reader of the call site learns that without following
// a closure.
func (b *{{ $b }}{{ $ta }}) Mutate(fn func(*{{ $v }}{{ $ta }})) *{{ $b }}{{ $ta }} {
	fn(&b.v)
	return b
}

{{ template "builder.clone" . }}

{{ wrapDoc (printf "Build returns the constructed [%s].\n\nThe builder stays usable afterwards, and a second call returns the value as it stands then — so a caller may build, set one more member, and build again. What it returns is a copy of the value under construction, but only as far as Go copies: a member holding a slice or a map is shared with the builder and with every value built from it, and [%s.Clone] is what separates them." $src $b) }}
func (b *{{ $b }}{{ $ta }}) Build() {{ $v }}{{ $ta }} {
{{- range (slot . "build").Items }}
	{{ render . }}
{{- end }}
	return b.v
}
{{- end -}}

{{- /* The constructor, whose body depends on what seeds it: a
       companion function, the declared defaults, or nothing. */ -}}
{{- define "builder.ctor" -}}
{{- $b := .TypeName -}}
{{- $src := .SourceName -}}
{{- $tp := renderTypeParams .TypeParams -}}
{{- $ta := .TypeArgs -}}
{{- $v := renderExpr .ValueRef -}}
{{- if .Companion }}
{{ wrapDoc (printf "%s returns a builder seeded from the package's companion, with any declared per-member default applied over it.\n\nTwo layers, in that order: whatever the companion supplies, then each member that declares its own default. A member the companion sets and the declaration does not keeps the companion's value, so the two sources compose rather than one replacing the other." .CtorName) }}
func {{ .CtorName }}{{ $tp }}() *{{ $b }}{{ $ta }} {
	v := {{ renderExpr .Companion }}{{ $ta }}()
{{- range .Fields }}{{ if .Declared }}
	v.{{ .Name }} = {{ template "builder.default" . }}
{{- end }}{{ end }}
	return &{{ $b }}{{ $ta }}{v: v}
}
{{- else if .Seeded }}
{{ wrapDoc (printf "%s returns a builder seeded with the declared defaults.\n\nOnly the members that declare one. Everything else holds its zero value, so a caller that sets nothing gets a mixture rather than either extreme — which is what makes a check against a built value worth writing." .CtorName) }}
func {{ .CtorName }}{{ $tp }}() *{{ $b }}{{ $ta }} {
	return &{{ $b }}{{ $ta }}{v: {{ $v }}{{ $ta }}{
{{- range .Fields }}{{ if .Declared }}
		{{ .Name }}: {{ template "builder.default" . }},
{{- end }}{{ end }}
	}}
}
{{- else }}
{{ wrapDoc (printf "%s returns a builder holding the zero value.\n\nNo member declares a default, so there is nothing to seed. A caller that builds immediately gets the same value a composite literal with no fields would, and the setters are what make it differ." .CtorName) }}
func {{ .CtorName }}{{ $tp }}() *{{ $b }}{{ $ta }} {
	return &{{ $b }}{{ $ta }}{}
}
{{- end }}
{{- end -}}

{{- /* One declared default. A value naming a symbol elsewhere renders
       through its reference so the file registers the import; a plain
       literal renders as the author wrote it. */ -}}
{{- define "builder.default" -}}
{{- if .DefaultRef }}{{ renderExpr .DefaultRef }}{{ else }}{{ .Default }}{{ end }}
{{- end -}}

{{- /* Every member's setters, each dispatched on its shape. */ -}}
{{- define "builder.setters" -}}
{{- $b := .TypeName -}}
{{- $ta := .TypeArgs -}}
{{- range $f := .Fields }}
{{- $with := $f.Set -}}
{{- $recv := printf "b *%s%s" $b $ta -}}
{{- $ret := printf "*%s%s" $b $ta -}}
{{- if $f.IsSequence }}
{{ wrapDoc (printf "%s replaces %s with the elements given.\n\nVariadic, and replacing: whatever the collection held is discarded, including anything a constructor seeded. %s is the counterpart that keeps it. Called with no arguments this empties the member rather than leaving it alone, which is how a caller clears a seeded default." $with $f.Name $f.Append) }}
func ({{ $recv }}) {{ $with }}(v ...{{ renderType $f.Elem }}) {{ $ret }} {
	b.v.{{ $f.Name }} = v
	return b
}

{{ wrapDoc (printf "%s adds to %s, keeping what is already there.\n\nThe counterpart to %s, which discards it. Both are offered because a caller extending a seeded default and a caller replacing it want opposite things, and one method cannot mean both." $f.Append $f.Name $with) }}
func ({{ $recv }}) {{ $f.Append }}(v ...{{ renderType $f.Elem }}) {{ $ret }} {
	b.v.{{ $f.Name }} = append(b.v.{{ $f.Name }}, v...)
	return b
}
{{ else if $f.IsBytes }}
{{ wrapDoc (printf "%s replaces %s with the bytes given.\n\nThe bytes are kept, not copied: the builder and every value built from it share the array the caller passed, so a caller that mutates it afterwards changes what was already built. %s is the form that takes text and has no such tie." $with $f.Name $f.SetText) }}
func ({{ $recv }}) {{ $with }}(v {{ renderType $f.Type }}) {{ $ret }} {
	b.v.{{ $f.Name }} = v
	return b
}

{{ wrapDoc (printf "%s replaces %s with the bytes of s.\n\nThe conversion is available for this element type and no other, and a caller holding text should not have to write it at every call site." $f.SetText $f.Name) }}
func ({{ $recv }}) {{ $f.SetText }}(s string) {{ $ret }} {
	b.v.{{ $f.Name }} = {{ renderType $f.Type }}(s)
	return b
}
{{ else if $f.IsSet }}
{{ wrapDoc (printf "%s replaces %s wholesale.\n\nThe whole collection, not one key: what the member held is discarded rather than merged into, and the map is kept rather than copied. %s is what adds to what is already there." $with $f.Name $f.SetEntry) }}
func ({{ $recv }}) {{ $with }}(v {{ renderType $f.Type }}) {{ $ret }} {
	b.v.{{ $f.Name }} = v
	return b
}

{{ wrapDoc (printf "%s adds one key to %s, allocating on first use.\n\nA set entry is a key. Every value in the collection is the same one, so there is nothing for a caller to supply and no parameter for it — a setter asking would be asking for the one thing they cannot vary." $f.SetEntry $f.Name) }}
func ({{ $recv }}) {{ $f.SetEntry }}(k {{ renderType $f.Key }}) {{ $ret }} {
	if b.v.{{ $f.Name }} == nil {
		b.v.{{ $f.Name }} = make({{ renderType $f.Type }})
	}
	b.v.{{ $f.Name }}[k] = struct{}{}
	return b
}

{{ wrapDoc (printf "%s adds each key to %s, keeping those it holds.\n\nAdditive like %s, so two calls union rather than the second replacing the first. A key already present is left as it stands: a set holds a key or it does not, and adding one twice is the same as adding it once." $f.SetEntries $f.Name $f.SetEntry) }}
func ({{ $recv }}) {{ $f.SetEntries }}(keys ...{{ renderType $f.Key }}) {{ $ret }} {
	if b.v.{{ $f.Name }} == nil {
		b.v.{{ $f.Name }} = make({{ renderType $f.Type }}, len(keys))
	}
	for _, k := range keys {
		b.v.{{ $f.Name }}[k] = struct{}{}
	}
	return b
}
{{ else if $f.IsMapping }}
{{ wrapDoc (printf "%s replaces %s wholesale.\n\nThe whole mapping, not one entry: what the member held is discarded rather than merged into, and the map is kept rather than copied — so a caller that writes to it afterwards changes what was already built. %s is what sets a single key." $with $f.Name $f.SetEntry) }}
func ({{ $recv }}) {{ $with }}(v {{ renderType $f.Type }}) {{ $ret }} {
	b.v.{{ $f.Name }} = v
	return b
}

{{ wrapDoc (printf "%s sets one key of %s, allocating on first use.\n\nA key already present takes the new value. The allocation is why this is offered at all: a caller writing to the member directly has to check for nil first, and the builder is the thing that knows whether a constructor seeded one." $f.SetEntry $f.Name) }}
func ({{ $recv }}) {{ $f.SetEntry }}(k {{ renderType $f.Key }}, v {{ renderType $f.Elem }}) {{ $ret }} {
	if b.v.{{ $f.Name }} == nil {
		b.v.{{ $f.Name }} = make({{ renderType $f.Type }})
	}
	b.v.{{ $f.Name }}[k] = v
	return b
}

{{ wrapDoc (printf "%s merges entries into %s.\n\nMerges rather than replaces: a key already present takes the new value, and keys absent from entries are left alone. Use %s to discard what is there." $f.SetEntries $f.Name $with) }}
func ({{ $recv }}) {{ $f.SetEntries }}(entries {{ renderType $f.Type }}) {{ $ret }} {
	if b.v.{{ $f.Name }} == nil {
		b.v.{{ $f.Name }} = make({{ renderType $f.Type }}, len(entries))
	}
	for k, v := range entries {
		b.v.{{ $f.Name }}[k] = v
	}
	return b
}
{{ else if $f.IsOptional }}
{{ wrapDoc (printf "%s replaces %s, taking the value and addressing it, so a caller need not hold a variable to point at.\n\nUse [%s.Mutate] to clear the member, or to point it at an address that already exists." $with $f.Name $b) }}
func ({{ $recv }}) {{ $with }}(v {{ renderType $f.Elem }}) {{ $ret }} {
	b.v.{{ $f.Name }} = &v
	return b
}
{{ else }}
{{ wrapDoc (printf "%s replaces %s.\n\nThe later call wins: a setter overwrites rather than merges, so a caller building from a constructor that seeded this member states only what it varies." $with $f.Name) }}
func ({{ $recv }}) {{ $with }}(v {{ renderType $f.Type }}) {{ $ret }} {
	b.v.{{ $f.Name }} = v
	return b
}
{{ end }}
{{- end }}
{{- end -}}

{{- /* Clone, copying exactly the members that own storage. */ -}}
{{- define "builder.clone" -}}
{{- $b := .TypeName -}}
{{- $ta := .TypeArgs -}}
{{ wrapDoc (printf "Clone returns a builder that can be configured without affecting this one.\n\nOne level deep, and the boundary matters. The sequence, byte-sequence and keyed members are copied, so appending or setting an entry through one clone is not visible through another.\n\nWhat is shared: anything held *inside* those — a struct in a slice that owns a slice of its own — and every optional member, which is what a reference means. Mutating through one of those does reach the original. Use [%s.Mutate] to replace such a member outright rather than editing it in place." $b) }}
func (b *{{ $b }}{{ $ta }}) Clone() *{{ $b }}{{ $ta }} {
	out := &{{ $b }}{{ $ta }}{v: b.v}
{{- range $f := .Fields }}
{{- if $f.Copies }}
	if b.v.{{ $f.Name }} != nil {
{{- if $f.Keyed }}
		out.v.{{ $f.Name }} = make({{ renderType $f.Type }}, len(b.v.{{ $f.Name }}))
		for k, v := range b.v.{{ $f.Name }} {
			out.v.{{ $f.Name }}[k] = v
		}
{{- else }}
		out.v.{{ $f.Name }} = append({{ renderType $f.Type }}(nil), b.v.{{ $f.Name }}...)
{{- end }}
	}
{{- end }}
{{- end }}
	return out
}
{{- end -}}
