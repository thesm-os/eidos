{{- /* The checks over a package's error contract.

       Single-subject assertions go through the backend's assertion
       dialect — `assertEqual` and friends — so the generated file
       depends on nothing but `testing`, `errors`, `fmt` and
       `strings`, and a repository preferring a helper library
       replaces the dialect rather than these templates.

       Assertions inside a loop are written out instead. The dialect's
       message is a literal, and a failure over a set has to name
       which member of it broke — a report that says only "two
       sentinels match" sends the reader to compare every pair by
       hand. The pairs are not unrolled to get the literal back
       because the count is quadratic in a number this plugin does not
       bound.

       One t.Run per asserted behaviour, each parallel, so a failure
       names the property that broke rather than the function it was
       written in. */ -}}

{{- define "sentinel.tests" -}}
{{- $T := renderExpr (external "testing" "T") -}}
{{- if .Sentinels }}
{{ wrapDoc (printf "%s pins the contract every declared error in this package carries.\n\nCallers match on these values, read them in logs and branch on them, so their messages and identities are as much an API as any exported signature — and nothing in the compiler holds them to it." (testFuncName .PackageName "Sentinels")) }}
func {{ testFuncName .PackageName "Sentinels" }}(t *{{ $T }}) {
	t.Parallel()

{{ template "sentinel.tests.declared" . }}
}
{{- end }}
{{- range .ErrTypes }}

{{ wrapDoc (printf "%s pins what %s owes a caller beyond taking part in the error protocol." (testFuncName .Name "Contract") .Name) }}
func {{ testFuncName .Name "Contract" }}(t *{{ $T }}) {
	t.Parallel()

{{ template "sentinel.tests.type" . }}
}
{{- end }}
{{- range (slot . "checks").Items }}

{{ render . }}
{{- end }}
{{- end -}}

{{- /* What every declared error in the package owes. */ -}}
{{- define "sentinel.tests.declared" -}}
{{- $T := renderExpr (external "testing" "T") -}}
{{- $is := renderExpr (external "errors" "Is") -}}
{{- $hasPrefix := renderExpr (external "strings" "HasPrefix") -}}
	all := []struct {
		name string
		err  error
	}{
{{- range .Sentinels }}
		{"{{ .Name }}", {{ renderExpr .Ref }}},
{{- end }}
	}

	t.Run("every sentinel is assigned", func(t *{{ $T }}) {
		t.Parallel()
		// A var declared and never assigned is nil, compiles, and
		// matches nothing — so every caller's branch on it is dead, and
		// no other check here can run without panicking.
		for _, e := range all {
			if e.err == nil {
				t.Fatalf("every sentinel must be assigned: %s is nil", e.name)
			}
		}
	})

	t.Run("every sentinel carries a message", func(t *{{ $T }}) {
		t.Parallel()
		// An empty message reaches a log as nothing at all, which is
		// worse than a bad one: the operator sees that something failed
		// and no indication of what.
		for _, e := range all {
			if e.err.Error() == "" {
				t.Errorf("every sentinel must carry a message: %s has none", e.name)
			}
		}
	})
{{- if .Prefix }}

	t.Run("every sentinel carries the package prefix", func(t *{{ $T }}) {
		t.Parallel()
		// A message without it reads in a log exactly like one from any
		// other package, which is the confusion the prefix exists to
		// prevent.
		for _, e := range all {
			if !{{ $hasPrefix }}(e.err.Error(), {{ printf "%q" .Prefix }}) {
				t.Errorf("every sentinel must carry the package prefix %q: %s reads %q",
					{{ printf "%q" .Prefix }}, e.name, e.err.Error())
			}
		}
	})
{{- else }}

	// No prefix check: this package suppressed it, so its messages are
	// deliberately bare. Every string begins with the empty string, so
	// a check written against one would pass for any input and read as
	// though the contract had been examined.
{{- end }}

	t.Run("no two sentinels share a message", func(t *{{ $T }}) {
		t.Parallel()
		// Two identical messages cannot be told apart in a log, and the
		// second is usually a copy that was meant to be edited.
		seen := map[string]string{}
		for _, e := range all {
			if first, dup := seen[e.err.Error()]; dup {
				t.Errorf("no two sentinels may share a message: %s repeats %s", e.name, first)
			}
			seen[e.err.Error()] = e.name
		}
	})

	t.Run("no sentinel's message begins with another's", func(t *{{ $T }}) {
		t.Parallel()
		// Distinct from sharing a message. One message that starts with
		// another makes every search for the shorter one match the
		// longer, and any code matching on message text ambiguous.
		for _, a := range all {
			for _, b := range all {
				if a.name == b.name {
					continue
				}
				if {{ $hasPrefix }}(a.err.Error(), b.err.Error()) {
					t.Errorf("no sentinel's message may begin with another's: %s begins with the whole of %s",
						a.name, b.name)
				}
			}
		}
	})

	t.Run("no sentinel matches another", func(t *{{ $T }}) {
		t.Parallel()
		// Two that match collapse a caller's branches into one, and the
		// caller cannot see it from the declarations.
		for _, a := range all {
			for _, b := range all {
				if a.name == b.name {
					continue
				}
				if {{ $is }}(a.err, b.err) {
					t.Errorf("no sentinel may match another: %s matches %s", a.name, b.name)
				}
			}
		}
	})

	// No check that a sentinel survives wrapping. Identity is compared
	// before anything a type declares is consulted, so every value
	// passes — including one whose own comparison always refuses. The
	// assertion would be about the standard library rather than about
	// this package.
{{- range .Neighbours }}

	t.Run("no sentinel matches one in {{ .Name }}", func(t *{{ $T }}) {
		t.Parallel()
{{- if .Sentinels }}
		// Distinct values describing the same condition are where a copy
		// between packages produces an alias, and neither package can
		// see it alone.
		for _, a := range all {
			for _, b := range []struct {
				name string
				err  error
			}{
{{- range .Sentinels }}
				{"{{ .Name }}", {{ renderExpr .Ref }}},
{{- end }}
			} {
				if {{ $is }}(a.err, b.err) {
					t.Errorf("no sentinel may match one in {{ .Name }}: %s matches %s", a.name, b.name)
				}
			}
		}
{{- else }}
		// {{ .Path }} declares no error value, so there is nothing to
		// overlap. The subtest is emitted anyway: a directive naming a
		// package that has none should read as an empty check rather
		// than as one that was never generated.
		_ = all
{{- end }}
	})
{{- end }}
{{- end -}}

{{- /* One error type's contract.

       Every package-level fact this needs is carried on the value —
       the prefix, the peers it must not match, the declared error a
       comparison check compares against — so the block stands on its
       own and a slot contributor extending it gets the same. */ -}}
{{- define "sentinel.tests.type" -}}
{{- $T := renderExpr (external "testing" "T") -}}
{{- $is := renderExpr (external "errors" "Is") -}}
{{- $unwrap := renderExpr (external "errors" "Unwrap") -}}
{{- $errorf := renderExpr (external "fmt" "Errorf") -}}
{{- $contains := renderExpr (external "strings" "Contains") -}}
{{- $hasPrefix := renderExpr (external "strings" "HasPrefix") -}}
{{- $amp := "" }}{{ if .Addressed }}{{ $amp = "&" }}{{ end }}
{{- $lit := printf "%s%s{}" $amp (renderExpr .Ref) -}}
	t.Run("reports a message for its zero value", func(t *{{ $T }}) {
		t.Parallel()
		// A message that reads through a member the zero value leaves
		// unset panics — replacing the error a caller needed to report
		// with a crash inside whatever was already going wrong.
		{{ assertNotEqual "t" (printf "(%s).Error()" $lit) `""` "an error must report a message without panicking" }}
	})
{{- if .Prefix }}

	t.Run("carries the package prefix like a sentinel does", func(t *{{ $T }}) {
		t.Parallel()
		// A custom error reaches the same logs as a declared one and is
		// read the same way, so it owes the same prefix. Checking only
		// the declared values leaves half a package's messages
		// unexamined.
		{{ assertTrue "t" (printf "%s((%s).Error(), %q)" $hasPrefix $lit .Prefix) "an error type must carry the package prefix" }}
	})
{{- end }}

	// No recovery check. Recovery finds a value by assignability while
	// walking the chain, so it succeeds for any type reachable through
	// it and fails for none. What a type can genuinely get wrong is its
	// own cause, which is checked below when it declares one.
{{- if .Peers }}

	t.Run("does not match the package's other error types", func(t *{{ $T }}) {
		t.Parallel()
		// Two error types that match each other collapse a caller's
		// branches, and the caller cannot see it from the declarations.
		subject := {{ $lit }}
		for _, other := range []error{
{{- range .Peers }}
			{{ if .Addressed }}&{{ end }}{{ renderExpr .Ref }}{},
{{- end }}
		} {
			{{ assertFalse "t" (printf "%s(subject, other)" $is) "an error type must not match another declared here" }}
		}
	})
{{- end }}
{{- if and .Compares (not .Unwraps) .Seed }}

	t.Run("agrees with the standard comparison about what it matches", func(t *{{ $T }}) {
		t.Parallel()
		// Emitted because the type declares its own comparison and no
		// cause. What is asserted is that the standard comparison
		// REACHES the declared method — one written on the wrong
		// receiver form is never consulted, and the type then silently
		// matches nothing.
		//
		// Both halves of that condition are load-bearing. The subject
		// carries a declared error, because a zero one answers false on
		// both sides whether the method was consulted or not. And the
		// type names no cause, because the comparison walks the chain
		// too: a type exposing the same cause that way matches
		// regardless, and the two sides then agree for every receiver
		// form — including the one this check exists to catch.
{{- if .Cause }}
		subject := {{ $amp }}{{ renderExpr .Ref }}{ {{- .Cause }}: {{ renderExpr .Seed.Ref }}}
{{- else }}
		subject := {{ $lit }}
{{- end }}
		for _, e := range []error{
{{- range .Seeds }}
			{{ renderExpr .Ref }},
{{- end }}
		} {
			{{ assertEqual "t" (printf "%s(subject, e)" $is) "subject.Is(e)" "the standard comparison must agree with the declared one" }}
		}
	})
{{- end }}
{{- if and .Compares .Unwraps .Seed }}

	// No agreement check: this type names a cause as well, so the
	// standard comparison reaches a declared error by walking the chain
	// whether or not the declared comparison was consulted. The two
	// sides then agree for every receiver form, including the one the
	// check exists to catch. What the cause itself owes is checked
	// below.
{{- end }}
{{- if and .Unwraps .Cause }}

	t.Run("exposes the cause it was given", func(t *{{ $T }}) {
		t.Parallel()
		// A wrapper that does not return its cause silently truncates
		// every chain it takes part in.
		cause := {{ $errorf }}("cause")
		// Declared and assigned rather than built as a literal: the
		// cause may sit on a folded-in type, where the selector is legal
		// and a composite-literal key is not.
{{- if .Addressed }}
		got := &{{ renderExpr .Ref }}{}
{{- else }}
		var got {{ renderExpr .Ref }}
{{- end }}
		got.{{ .Cause }} = cause
		// Unwrapping rather than comparing. A type declaring its own
		// comparison answers from there whatever the cause accessor
		// returns, so a comparison-based assertion passes against a
		// truncated chain — which is the one thing this check exists to
		// catch.
		{{ assertEqual "t" (printf "%s(got)" $unwrap) "cause" "an error naming a cause must expose it" }}
	})
{{- end }}
{{- if .Checked }}

	t.Run("puts every member it carries into its message", func(t *{{ $T }}) {
		t.Parallel()
		// A member the message drops is a detail the operator cannot
		// see, and the declaration is the only record that it was meant
		// to be visible.
		got := {{ $amp }}{{ renderExpr .Ref }}{
{{- range .Written }}
			{{ .Name }}: {{ renderSample .Sample }},
{{- end }}
		}
{{- range .Checked }}
		{{ assertTrue "t" (printf "%s(got.Error(), %s)" $contains (renderSample .Sample)) (printf "%s must reach the message" .Name) }}
{{- end }}
	})
{{- end }}
{{- end -}}
