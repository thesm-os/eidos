{{- define "enum.api" -}}
// String returns the textual form of {{ .TypeName }}.
func (v {{ .TypeName }}) String() string {
	switch v {
{{- range .Variants }}
	case {{ .ConstName }}:
		return {{ printf "%q" .StringValue }}
{{- end }}
	}
{{- if eq .Underlying "string" }}
	{{- /* A string enum's value is already its textual form, so an
	       undeclared one renders as itself: compilable, and the
	       string that failed to match is exactly what a caller
	       needs to see. A Sprintf fallback says strictly less. */}}
	return string(v)
{{- else }}
	{{- /* Conversion and verb both come from golang.EnumFallback, which
	       pairs them. Spelling either here re-decides it, and both prior
	       spellings were wrong in ways no render assertion can see:
	       `int(v)` truncates a float set to its integer part and does not
	       compile at all for one defined over another package's string
	       type, while `%d` then prints the wrong thing for either.
	       renderType registers the import a qualified conversion needs;
	       a name written into the template cannot ask for one. */}}
	return {{ renderExpr (external "fmt" "Sprintf") }}({{ printf "%q" (printf "%s(%s)" .TypeName .FallbackVerb) }}, {{ renderType .FallbackConv }}(v))
{{- end }}
}

// {{ .SentinelName }} is returned by {{ .ParseName }} when the
// input string doesn't match any declared variant.
var {{ .SentinelName }} = {{ renderExpr (external "errors" "New") }}({{ printf "%q" (printf "%s: unknown %s" "enum" .TypeName) }})

// {{ .ParseName }} parses s into a {{ .TypeName }} value, returning
// {{ .SentinelName }} when s does not match any declared variant.
func {{ .ParseName }}(s string) ({{ .TypeName }}, error) {
	switch s {
{{- range .Variants }}
	case {{ printf "%q" .StringValue }}:
		return {{ .ConstName }}, nil
{{- end }}
	}
	var zero {{ $.TypeName }}
	return zero, {{ $.SentinelName }}
}

// MarshalJSON serialises v as the variant's textual form.
func (v {{ .TypeName }}) MarshalJSON() ([]byte, error) {
	return {{ renderExpr (external "encoding/json" "Marshal") }}(v.String())
}

// UnmarshalJSON parses the variant's textual form, returning
// {{ .SentinelName }} when the decoded string is not a
// declared variant.
func (v *{{ .TypeName }}) UnmarshalJSON(data []byte) error {
	var s string
	if err := {{ renderExpr (external "encoding/json" "Unmarshal") }}(data, &s); err != nil {
		return err
	}
	parsed, err := {{ .ParseName }}(s)
	if err != nil {
		return err
	}
	*v = parsed
	return nil
}
{{- end -}}
